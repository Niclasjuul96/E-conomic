<Window x:Class="E_conomic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Width="1600" Height="900">

    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
        </Style>

        <!-- Bold Column Headers -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row for buttons -->
            <RowDefinition Height="*"/>
            <!-- Row for DataGrids -->
        </Grid.RowDefinitions>

        <!-- Upload & Settings Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10" Grid.Row="0">
            <Button Name="UploadButton" Content="Upload CSV" Width="120" Height="40" Click="OnUploadButtonClick"/>
            <Button Name="SettingsButton" Content="Settings" Width="120" Height="40" Margin="10,0,0,0" Click="OnSettingsButtonClick"/>
        </StackPanel>

        <!-- ScrollViewer to prevent text cutoff -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Income DataGrid -->
                <StackPanel Grid.Row="0" Margin="10">
                    <Label Content="Income Transactions" FontSize="16" FontWeight="Bold"/>
                    <DataGrid x:Name="IncomeDataGrid" ItemsSource="{Binding IncomeData}" 
                              AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}" 
                              HorizontalAlignment="Stretch" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                            <DataGridTextColumn Header="January" Binding="{Binding January, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="February" Binding="{Binding February, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="March" Binding="{Binding March, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="April" Binding="{Binding April, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="May" Binding="{Binding May, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="June" Binding="{Binding June, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="July" Binding="{Binding July, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="August" Binding="{Binding August, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="September" Binding="{Binding September, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="October" Binding="{Binding October, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="November" Binding="{Binding November, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="December" Binding="{Binding December, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat=N2}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Expense DataGrid -->
                <StackPanel Grid.Row="1" Margin="10">
                    <Label Content="Expense Transactions" FontSize="16" FontWeight="Bold"/>
                    <DataGrid x:Name="ExpenseDataGrid" ItemsSource="{Binding ExpenseData}" 
                              AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}" 
                              HorizontalAlignment="Stretch" MinHeight="200" LayoutUpdated="ExpenseDataGrid_LayoutUpdated">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                            <DataGridTextColumn Header="January" Binding="{Binding January, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="February" Binding="{Binding February, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="March" Binding="{Binding March, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="April" Binding="{Binding April, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="May" Binding="{Binding May, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="June" Binding="{Binding June, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="July" Binding="{Binding July, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="August" Binding="{Binding August, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="September" Binding="{Binding September, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="October" Binding="{Binding October, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="November" Binding="{Binding November, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="December" Binding="{Binding December, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="Auto"/>
                            <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat=N2}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
