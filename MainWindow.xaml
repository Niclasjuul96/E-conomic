<Window x:Class="E_conomic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budget Overview" Width="1600" Height="900">

    <Window.Resources>
        <!-- Style for DataGrids -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
        </Style>

        <!-- Bold Column Headers -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <!-- Full Scrollable Window -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
                <RowDefinition Height="Auto"/>
                <!-- Income DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Expense DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Disposable Income DataGrid -->
            </Grid.RowDefinitions>

            <!-- Upload & Settings Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10" Grid.Row="0">
                <Button Name="UploadButton" Content="Upload CSV" Width="120" Height="40" Click="OnUploadButtonClick"/>
                <Button Name="SettingsButton" Content="Settings" Width="120" Height="40" Margin="10,0,0,0" Click="OnSettingsButtonClick"/>
            </StackPanel>

            <!-- DataGrids StackPanel -->
            <StackPanel Grid.Row="1" Margin="10">
                <!-- Income DataGrid -->
                <Label Content="Income Transactions" FontSize="16" FontWeight="Bold" Margin="5"/>
                <DataGrid x:Name="IncomeDataGrid" ItemsSource="{Binding IncomeData}" ColumnHeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}" HorizontalAlignment="Left" MaxWidth="1600">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                        <DataGridTextColumn Header="January" Binding="{Binding January, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="February" Binding="{Binding February, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="March" Binding="{Binding March, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="April" Binding="{Binding April, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="May" Binding="{Binding May, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="June" Binding="{Binding June, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="July" Binding="{Binding July, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="August" Binding="{Binding August, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="September" Binding="{Binding September, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="October" Binding="{Binding October, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="November" Binding="{Binding November, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="December" Binding="{Binding December, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="Auto"/>
                        <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat=N2}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Expense DataGrid -->
                <Label Content="Expense Transactions" FontSize="16" FontWeight="Bold" Margin="5"/>
                <DataGrid x:Name="ExpenseDataGrid" ItemsSource="{Binding ExpenseData}" ColumnHeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}" HorizontalAlignment="Left" MaxWidth="1600">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                        <DataGridTextColumn Header="January" Binding="{Binding January, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="February" Binding="{Binding February, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="March" Binding="{Binding March, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="April" Binding="{Binding April, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="May" Binding="{Binding May, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="June" Binding="{Binding June, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="July" Binding="{Binding July, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="August" Binding="{Binding August, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="September" Binding="{Binding September, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="October" Binding="{Binding October, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="November" Binding="{Binding November, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="December" Binding="{Binding December, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="Auto"/>
                        <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat=N2}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Disposable Income DataGrid -->
                <Label Content="Disposable Income" FontSize="16" FontWeight="Bold" Margin="5"/>
                <DataGrid x:Name="DisposableIncomeDataGrid" ItemsSource="{Binding DisposableIncomeData}" ColumnHeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}" HorizontalAlignment="Left" MaxWidth="1600">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                        <DataGridTextColumn Header="January" Binding="{Binding January, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="February" Binding="{Binding February, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="March" Binding="{Binding March, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="April" Binding="{Binding April, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="May" Binding="{Binding May, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="June" Binding="{Binding June, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="July" Binding="{Binding July, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="August" Binding="{Binding August, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="September" Binding="{Binding September, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="October" Binding="{Binding October, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="November" Binding="{Binding November, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="December" Binding="{Binding December, StringFormat=N2}" Width="*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="Auto"/>
                        <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat=N2}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
